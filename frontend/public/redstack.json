{
  "schema_version": "0.4.0",
  "mode": "ops",
  "name": "redStack default blueprint",
  "prefix": "red",
  "description": "The redStack topology: an Apache redirector in its own network, peered to the main range, routing three C2 backends on separate URI prefixes. The main range holds the teamservers in their own subnet, and one internal subnet holding the Guacamole jumpbox, the Kali and Windows operator boxes, and a log collector. That one subnet is redStack's shape: the jumpbox holds a public address, everyone behind it is internal only and reaches out through it. The redirector sits in a separate peered network so the internet facing tier is its own blast radius. A log collector is included because a blueprint should be the recommended shape rather than a transcription; redStack itself has none. The URI prefixes and the gating header are placeholders, not redStack's values.",
  "auto_stop": {
    "enabled": true,
    "after_hours": 8,
    "timezone": "UTC"
  },
  "nodes": [
    {
      "id": "main-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.30.0.0/16"
      }
    },
    {
      "id": "rdir-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.31.0.0/16"
      }
    },
    {
      "id": "mgmt-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.30.0.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "management"
      }
    },
    {
      "id": "ops-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.30.10.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "management"
      }
    },
    {
      "id": "c2-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.30.20.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "c2"
      }
    },
    {
      "id": "rdir-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.31.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "jump-bx01",
      "kind": "jumpbox",
      "overlay": {
        "services": [
          "ssh",
          "guacamole",
          "wireguard"
        ],
        "certificate_authority": true
      }
    },
    {
      "id": "apache-rd01",
      "kind": "redirector",
      "overlay": {
        "server": "apache",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "myth-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "mythic"
      }
    },
    {
      "id": "sliv-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "sliver"
      }
    },
    {
      "id": "adpx-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "adaptix"
      }
    },
    {
      "id": "open-log01",
      "kind": "collector",
      "overlay": {
        "sink": "opensearch",
        "shipper": "filebeat",
        "ingest_port": 5044,
        "tls": true
      }
    },
    {
      "id": "kali-op01",
      "kind": "operator",
      "overlay": {
        "os": "kali"
      }
    },
    {
      "id": "win-op01",
      "kind": "operator",
      "overlay": {
        "os": "windows"
      }
    }
  ],
  "edges": [
    {
      "id": "e-mgmt-sub01-main-net01-attached",
      "role": "attached",
      "source": "mgmt-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-ops-sub01-main-net01-attached",
      "role": "attached",
      "source": "ops-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-c2-sub01-main-net01-attached",
      "role": "attached",
      "source": "c2-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-rdir-sub01-rdir-net01-attached",
      "role": "attached",
      "source": "rdir-sub01",
      "target": "rdir-net01"
    },
    {
      "id": "e-jump-bx01-mgmt-sub01-attached",
      "role": "attached",
      "source": "jump-bx01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-apache-rd01-rdir-sub01-attached",
      "role": "attached",
      "source": "apache-rd01",
      "target": "rdir-sub01"
    },
    {
      "id": "e-myth-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "myth-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-sliv-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "sliv-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-adpx-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "adpx-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-open-log01-ops-sub01-attached",
      "role": "attached",
      "source": "open-log01",
      "target": "ops-sub01"
    },
    {
      "id": "e-kali-op01-ops-sub01-attached",
      "role": "attached",
      "source": "kali-op01",
      "target": "ops-sub01"
    },
    {
      "id": "e-win-op01-ops-sub01-attached",
      "role": "attached",
      "source": "win-op01",
      "target": "ops-sub01"
    },
    {
      "id": "e-main-net01-rdir-net01-peers",
      "role": "peers",
      "source": "main-net01",
      "target": "rdir-net01"
    },
    {
      "id": "e-apache-rd01-myth-ts01-fronts",
      "role": "fronts",
      "source": "apache-rd01",
      "target": "myth-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-apache-rd01-sliv-ts01-fronts",
      "role": "fronts",
      "source": "apache-rd01",
      "target": "sliv-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/cdn/assets"
    },
    {
      "id": "e-apache-rd01-adpx-ts01-fronts",
      "role": "fronts",
      "source": "apache-rd01",
      "target": "adpx-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/updates"
    },
    {
      "id": "e-apache-rd01-open-log01-logs-to",
      "role": "logs_to",
      "source": "apache-rd01",
      "target": "open-log01"
    },
    {
      "id": "e-myth-ts01-open-log01-logs-to",
      "role": "logs_to",
      "source": "myth-ts01",
      "target": "open-log01"
    },
    {
      "id": "e-sliv-ts01-open-log01-logs-to",
      "role": "logs_to",
      "source": "sliv-ts01",
      "target": "open-log01"
    },
    {
      "id": "e-adpx-ts01-open-log01-logs-to",
      "role": "logs_to",
      "source": "adpx-ts01",
      "target": "open-log01"
    },
    {
      "id": "e-jump-bx01-main-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "main-net01"
    },
    {
      "id": "e-jump-bx01-rdir-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "rdir-net01"
    }
  ]
}
