{
  "schema_version": "0.5.0",
  "mode": "ops",
  "name": "Redirector rollover",
  "prefix": "red",
  "description": "A resilience shape: three interchangeable front doors, two Apache and one Nginx on distinct hostnames, all fronting one Mythic teamserver on the same URI. When a redirector is burned or blocked you roll traffic to the next without touching the backend. The redirectors share their own peered network so the internet facing tier is a single blast radius, and every front door plus the teamserver ships hits to a log collector so you can see which lure is still alive. Hostnames, prefixes, and the gating header are placeholders.",
  "auto_stop": {
    "enabled": true,
    "after_hours": 8,
    "timezone": "UTC"
  },
  "nodes": [
    {
      "id": "main-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.40.0.0/16"
      }
    },
    {
      "id": "rdir-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.41.0.0/16"
      }
    },
    {
      "id": "mgmt-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.40.0.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "management"
      }
    },
    {
      "id": "c2-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.40.20.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "c2"
      }
    },
    {
      "id": "rdir-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.41.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "jump-bx01",
      "kind": "jumpbox",
      "overlay": {
        "services": [
          "ssh",
          "guacamole",
          "wireguard"
        ],
        "certificate_authority": true
      }
    },
    {
      "id": "apache-rd01",
      "kind": "redirector",
      "overlay": {
        "server": "apache",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "nginx-rd01",
      "kind": "redirector",
      "overlay": {
        "server": "nginx",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "apache-rd02",
      "kind": "redirector",
      "overlay": {
        "server": "apache",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "sliver-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "sliver"
      }
    },
    {
      "id": "open-log01",
      "kind": "collector",
      "overlay": {
        "sink": "opensearch",
        "shipper": "filebeat",
        "ingest_port": 5044,
        "tls": true
      }
    },
    {
      "id": "kali-op01",
      "kind": "operator",
      "overlay": {
        "os": "kali"
      }
    }
  ],
  "edges": [
    {
      "id": "e-mgmt-sub01-main-net01-attached",
      "role": "attached",
      "source": "mgmt-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-c2-sub01-main-net01-attached",
      "role": "attached",
      "source": "c2-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-rdir-sub01-rdir-net01-attached",
      "role": "attached",
      "source": "rdir-sub01",
      "target": "rdir-net01"
    },
    {
      "id": "e-jump-bx01-mgmt-sub01-attached",
      "role": "attached",
      "source": "jump-bx01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-apache-rd01-rdir-sub01-attached",
      "role": "attached",
      "source": "apache-rd01",
      "target": "rdir-sub01"
    },
    {
      "id": "e-nginx-rd01-rdir-sub01-attached",
      "role": "attached",
      "source": "nginx-rd01",
      "target": "rdir-sub01"
    },
    {
      "id": "e-apache-rd02-rdir-sub01-attached",
      "role": "attached",
      "source": "apache-rd02",
      "target": "rdir-sub01"
    },
    {
      "id": "e-sliver-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "sliver-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-open-log01-mgmt-sub01-attached",
      "role": "attached",
      "source": "open-log01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-kali-op01-mgmt-sub01-attached",
      "role": "attached",
      "source": "kali-op01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-main-net01-rdir-net01-peers",
      "role": "peers",
      "source": "main-net01",
      "target": "rdir-net01"
    },
    {
      "id": "e-apache-rd01-sliver-ts01-fronts",
      "role": "fronts",
      "source": "apache-rd01",
      "target": "sliver-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-nginx-rd01-sliver-ts01-fronts",
      "role": "fronts",
      "source": "nginx-rd01",
      "target": "sliver-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-apache-rd02-sliver-ts01-fronts",
      "role": "fronts",
      "source": "apache-rd02",
      "target": "sliver-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-apache-rd01-open-log01-logs-to",
      "role": "logs_to",
      "source": "apache-rd01",
      "target": "open-log01"
    },
    {
      "id": "e-nginx-rd01-open-log01-logs-to",
      "role": "logs_to",
      "source": "nginx-rd01",
      "target": "open-log01"
    },
    {
      "id": "e-apache-rd02-open-log01-logs-to",
      "role": "logs_to",
      "source": "apache-rd02",
      "target": "open-log01"
    },
    {
      "id": "e-sliver-ts01-open-log01-logs-to",
      "role": "logs_to",
      "source": "sliver-ts01",
      "target": "open-log01"
    },
    {
      "id": "e-jump-bx01-main-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "main-net01"
    },
    {
      "id": "e-jump-bx01-rdir-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "rdir-net01"
    }
  ]
}
