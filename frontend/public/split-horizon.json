{
  "schema_version": "0.7.0",
  "mode": "offense",
  "name": "Split horizon C2",
  "prefix": "off",
  "description": "Two front doors that do not share a fate, each serving the backends it was chosen for. A long haul Apache redirector fronts a Sliver teamserver for the slow beacons that have to survive weeks, and a separate Nginx redirector on its own network fronts Mythic and Adaptix for the interactive work, each on its own URI prefix. Each redirector sits in its own peered network, so burning the interactive front door costs you the interactive sessions and nothing else, and the long haul chain never appears in the same blast radius. Every front door and every teamserver ships to one collector, because the whole point of splitting the tiers is being able to tell which one is still alive. A Kali box and a Windows operator box sit behind the jumpbox, which is the only public host and manages all three networks.",
  "auto_stop": {
    "enabled": true,
    "after_hours": 8,
    "timezone": "UTC"
  },
  "nodes": [
    {
      "id": "main-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.40.0.0/16"
      }
    },
    {
      "id": "long-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.41.0.0/16"
      }
    },
    {
      "id": "intr-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.42.0.0/16"
      }
    },
    {
      "id": "mgmt-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.40.0.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "management"
      }
    },
    {
      "id": "ops-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.40.10.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "management"
      }
    },
    {
      "id": "c2-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.40.20.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "c2"
      }
    },
    {
      "id": "long-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.41.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "intr-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.42.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "jump-bx01",
      "kind": "jumpbox",
      "overlay": {
        "services": [
          "ssh",
          "guacamole"
        ],
        "certificate_authority": true
      }
    },
    {
      "id": "apa-rd01",
      "kind": "redirector",
      "overlay": {
        "server": "apache",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "ngx-rd02",
      "kind": "redirector",
      "overlay": {
        "server": "nginx",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Correlation-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "maintenance"
        }
      }
    },
    {
      "id": "sliv-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "sliver"
      }
    },
    {
      "id": "myth-ts02",
      "kind": "teamserver",
      "overlay": {
        "c2": "mythic"
      }
    },
    {
      "id": "open-log01",
      "kind": "collector",
      "overlay": {
        "sink": "opensearch",
        "shipper": "filebeat",
        "ingest_port": 5044,
        "tls": true
      }
    },
    {
      "id": "adpx-ts03",
      "kind": "teamserver",
      "overlay": {
        "c2": "adaptix"
      }
    },
    {
      "id": "kali-op01",
      "kind": "operator",
      "overlay": {
        "os": "kali"
      }
    },
    {
      "id": "win-op01",
      "kind": "operator",
      "overlay": {
        "os": "windows"
      }
    }
  ],
  "edges": [
    {
      "id": "e-mgmt-sub01-main-net01-attached",
      "role": "attached",
      "source": "mgmt-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-ops-sub01-main-net01-attached",
      "role": "attached",
      "source": "ops-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-c2-sub01-main-net01-attached",
      "role": "attached",
      "source": "c2-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-long-sub01-long-net01-attached",
      "role": "attached",
      "source": "long-sub01",
      "target": "long-net01"
    },
    {
      "id": "e-intr-sub01-intr-net01-attached",
      "role": "attached",
      "source": "intr-sub01",
      "target": "intr-net01"
    },
    {
      "id": "e-jump-bx01-mgmt-sub01-attached",
      "role": "attached",
      "source": "jump-bx01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-apa-rd01-long-sub01-attached",
      "role": "attached",
      "source": "apa-rd01",
      "target": "long-sub01"
    },
    {
      "id": "e-ngx-rd02-intr-sub01-attached",
      "role": "attached",
      "source": "ngx-rd02",
      "target": "intr-sub01"
    },
    {
      "id": "e-sliv-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "sliv-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-myth-ts02-c2-sub01-attached",
      "role": "attached",
      "source": "myth-ts02",
      "target": "c2-sub01"
    },
    {
      "id": "e-open-log01-ops-sub01-attached",
      "role": "attached",
      "source": "open-log01",
      "target": "ops-sub01"
    },
    {
      "id": "e-adpx-ts03-c2-sub01-attached",
      "role": "attached",
      "source": "adpx-ts03",
      "target": "c2-sub01"
    },
    {
      "id": "e-kali-op01-ops-sub01-attached",
      "role": "attached",
      "source": "kali-op01",
      "target": "ops-sub01"
    },
    {
      "id": "e-win-op01-ops-sub01-attached",
      "role": "attached",
      "source": "win-op01",
      "target": "ops-sub01"
    },
    {
      "id": "e-main-net01-long-net01-peers",
      "role": "peers",
      "source": "main-net01",
      "target": "long-net01"
    },
    {
      "id": "e-main-net01-intr-net01-peers",
      "role": "peers",
      "source": "main-net01",
      "target": "intr-net01"
    },
    {
      "id": "e-apa-rd01-sliv-ts01-fronts",
      "role": "fronts",
      "source": "apa-rd01",
      "target": "sliv-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/cdn/assets"
    },
    {
      "id": "e-ngx-rd02-myth-ts02-fronts",
      "role": "fronts",
      "source": "ngx-rd02",
      "target": "myth-ts02",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-ngx-rd02-adpx-ts03-fronts",
      "role": "fronts",
      "source": "ngx-rd02",
      "target": "adpx-ts03",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/system/check"
    },
    {
      "id": "e-adpx-ts03-open-log01-logs-to",
      "role": "logs_to",
      "source": "adpx-ts03",
      "target": "open-log01"
    },
    {
      "id": "e-apa-rd01-open-log01-logs-to",
      "role": "logs_to",
      "source": "apa-rd01",
      "target": "open-log01"
    },
    {
      "id": "e-ngx-rd02-open-log01-logs-to",
      "role": "logs_to",
      "source": "ngx-rd02",
      "target": "open-log01"
    },
    {
      "id": "e-sliv-ts01-open-log01-logs-to",
      "role": "logs_to",
      "source": "sliv-ts01",
      "target": "open-log01"
    },
    {
      "id": "e-myth-ts02-open-log01-logs-to",
      "role": "logs_to",
      "source": "myth-ts02",
      "target": "open-log01"
    },
    {
      "id": "e-jump-bx01-main-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "main-net01"
    },
    {
      "id": "e-jump-bx01-long-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "long-net01"
    },
    {
      "id": "e-jump-bx01-intr-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "intr-net01"
    }
  ]
}