    {
      "id": "balerion",
      "kind": "dc",
      "position": {
        "x": 16,
        "y": 48
      },
      "overlay": {
        "os": "windows_server_2019",
        "hostname": "balerion",
        "vulns": [
          "enable_credssp_client",
          "schedule",
          "ldaps"
        ],
        "vulns_vars": {
          "schedule": {
            "name": "keepass_bot",
            "script_path": "C:\\keepass_bot.ps1",
            "script_content": "# keepass_bot: a recurring domain session that opens a KeePass vault on\n# vhagar over a CredSSP double-hop. It runs as rhaegal (a local admin on\n# vhagar), and CredSSP delegates rhaegal's plaintext credential to vhagar --\n# so anyone holding vhagar can recover rhaegal's password from the delegated\n# logon, and the vault it opens holds the domain-admin credential. Mirrors\n# GOAD's dracarys keepass_bot.\n$ErrorActionPreference = 'SilentlyContinue'\n$pass  = ConvertTo-SecureString 'ufsmcvDaFz1uEqzAtaiL' -AsPlainText -Force\n$creds = New-Object System.Management.Automation.PSCredential('dracarys.lab\\rhaegal', $pass)\nInvoke-Command -ComputerName vhagar.dracarys.lab -Authentication Credssp -Credential $creds -ScriptBlock {\n    $kp = 'C:\\Program Files\\KeePass Password Safe 2\\KeePass.exe'\n    $db = 'C:\\vault.kdbx'\n    $master = 'lj-endlmkfQSLDKPDFNZLEK'\n    if (Test-Path $kp) { cmd /c \"echo $master | `\"$kp`\" `\"$db`\" -pw-stdin\" }\n    Start-Sleep -Seconds 20\n    Get-Process KeePass -ErrorAction SilentlyContinue | Stop-Process -Force\n}\n",
            "command": "& C:\\keepass_bot.ps1",
            "interval_minutes": 1,
            "user": "dracarys\\rhaegal"
          }
        }
      }
    },
    {
      "id": "vhagar",
      "kind": "srv",
      "position": {
        "x": 268,
        "y": 48
      },
      "overlay": {
        "os": "windows_server_2019",
        "hostname": "vhagar",
        "vulns": [
          "enable_credssp_server",
          "schedule",
          "keepass_vault",
          "constrained_delegation_kerberos"
        ],
        "vulns_vars": {
          "delegate_to": [
            "WSMAN/vhagar.dracarys.lab"
          ],
          "keepass_vault": {
            "db_path": "C:\\vault.kdbx",
            "master_password": "lj-endlmkfQSLDKPDFNZLEK",
            "entry_title": "domain-admin",
            "entry_user": "drogon",
            "entry_password_user": "drogon"
          },
          "schedule": {
            "name": "bot_ssh",
            "script_path": "C:\\bot_ssh.ps1",
            "script_content": "# bot_ssh: a recurring logon that reaches the Linux member syrax as\n# viserion. It authenticates viserion to syrax every minute, so an operator\n# who already holds a foothold on syrax (the challenge start point) can\n# observe or capture viserion's credential. Uses PuTTY's plink for scripted\n# password auth, downloading it on first run if absent. Mirrors GOAD's\n# dracarys bot_ssh.\n$ErrorActionPreference = 'SilentlyContinue'\n$plink = 'C:\\plink.exe'\nif (-not (Test-Path $plink)) {\n    try { Invoke-WebRequest -UseBasicParsing -Uri 'https://the.earth.li/~sgtatham/putty/latest/w64/plink.exe' -OutFile $plink } catch {}\n}\nif (Test-Path $plink) {\n    & $plink -ssh -batch -pw 'aLHtz1WvIVmeV4Zh4CDE' 'viserion@syrax.dracarys.lab' 'id; sleep 45'\n}\n",
            "command": "& C:\\bot_ssh.ps1",
            "interval_minutes": 1,
            "user": "dracarys\\viserion"
          }
        }
      }
    },
