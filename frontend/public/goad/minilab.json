        "hostname": "dc",
        "vulns": [
          "stored_credential",
          "schedule",
          "enable_credssp_client"
        ],
        "notes": "Unmapped GOAD vulns: files, enable_credssp_client, schedule.",
        "vulns_vars": {
          "stored_credential": {
            "owner": "MINILAB\\alice",
            "target": "TERMSRV/alicesecret",
            "username": "MINILAB\\alice"
          },
          "schedule": {
            "name": "connect_bot",
            "script_path": "C:\\bot.ps1",
            "script_content": "New-PSDrive -Name X -PSProvider FileSystem -Root \\\\ws\\C$ -ErrorAction SilentlyContinue | Out-Null\nStart-Sleep -Seconds 5\n",
            "command": "& C:\\bot.ps1",
            "interval_minutes": 1,
            "user": "MINILAB\\alice"
          }
        }
