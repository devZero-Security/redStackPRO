{
  "schema_version": "0.4.0",
  "mode": "ops",
  "name": "MinimalC2-GUI",
  "prefix": "red",
  "description": "The smallest UI-driven redStack: one Mythic teamserver behind a single Apache redirector, driven from a browser on a GUI-mode Kali operator reached over a Guacamole RDP tile rather than SSH, through a Guacamole jumpbox. The redirector sits in its own peered network so the internet facing tier is its own blast radius, the same isolation redStack uses, trimmed to a single C2 backend with no log collector and no second operator. A starting point to grow from.",
  "auto_stop": {
    "enabled": true,
    "after_hours": 8,
    "timezone": "UTC"
  },
  "nodes": [
    {
      "id": "main-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.20.0.0/16"
      }
    },
    {
      "id": "rdir-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.21.0.0/16"
      }
    },
    {
      "id": "mgmt-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.20.0.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "management"
      }
    },
    {
      "id": "c2-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.20.20.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "c2"
      }
    },
    {
      "id": "rdir-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.21.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "jump-bx01",
      "kind": "jumpbox",
      "overlay": {
        "services": [
          "ssh",
          "guacamole",
          "wireguard"
        ],
        "certificate_authority": true
      }
    },
    {
      "id": "apache-rd01",
      "kind": "redirector",
      "overlay": {
        "server": "apache",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "c2-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "mythic"
      }
    },
    {
      "id": "kali-op01",
      "kind": "operator",
      "overlay": {
        "os": "kali",
        "desktop": true
      }
    }
  ],
  "edges": [
    {
      "id": "e-mgmt-sub01-main-net01-attached",
      "role": "attached",
      "source": "mgmt-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-c2-sub01-main-net01-attached",
      "role": "attached",
      "source": "c2-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-rdir-sub01-rdir-net01-attached",
      "role": "attached",
      "source": "rdir-sub01",
      "target": "rdir-net01"
    },
    {
      "id": "e-jump-bx01-mgmt-sub01-attached",
      "role": "attached",
      "source": "jump-bx01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-apache-rd01-rdir-sub01-attached",
      "role": "attached",
      "source": "apache-rd01",
      "target": "rdir-sub01"
    },
    {
      "id": "e-c2-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "c2-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-kali-op01-mgmt-sub01-attached",
      "role": "attached",
      "source": "kali-op01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-main-net01-rdir-net01-peers",
      "role": "peers",
      "source": "main-net01",
      "target": "rdir-net01"
    },
    {
      "id": "e-apache-rd01-c2-ts01-fronts",
      "role": "fronts",
      "source": "apache-rd01",
      "target": "c2-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-jump-bx01-main-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "main-net01"
    },
    {
      "id": "e-jump-bx01-rdir-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "rdir-net01"
    }
  ]
}
