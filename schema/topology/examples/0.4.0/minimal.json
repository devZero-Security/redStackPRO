{
  "schema_version": "0.4.0",
  "mode": "ops",
  "name": "Minimal single redirector",
  "description": "Smallest valid graph. One redirector fronting one teamserver, reached for configuration through a jumpbox. No log collection.",
  "nodes": [
    {
      "id": "main-net01",
      "kind": "network",
      "overlay": {
        "cidr": "10.20.0.0/16"
      }
    },
    {
      "id": "mgmt-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.20.0.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "management"
      }
    },
    {
      "id": "rdir-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.20.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "c2-sub01",
      "kind": "segment",
      "overlay": {
        "cidr": "10.20.20.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "c2"
      }
    },
    {
      "id": "jump-bx01",
      "kind": "jumpbox",
      "overlay": {
        "services": [
          "ssh",
          "wireguard"
        ],
        "certificate_authority": true
      }
    },
    {
      "id": "nginx-rd01",
      "kind": "redirector",
      "overlay": {
        "server": "nginx",
        "tls": {
          "cert_source": "letsencrypt"
        },
        "gating": {
          "header_name": "X-Request-Id",
          "header_value": "",
          "redirect_rules": true,
          "decoy": "cdn"
        }
      }
    },
    {
      "id": "myth-ts01",
      "kind": "teamserver",
      "overlay": {
        "c2": "mythic"
      }
    }
  ],
  "edges": [
    {
      "id": "e-mgmt-sub01-main-net01-attached",
      "role": "attached",
      "source": "mgmt-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-rdir-sub01-main-net01-attached",
      "role": "attached",
      "source": "rdir-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-c2-sub01-main-net01-attached",
      "role": "attached",
      "source": "c2-sub01",
      "target": "main-net01"
    },
    {
      "id": "e-jump-bx01-mgmt-sub01-attached",
      "role": "attached",
      "source": "jump-bx01",
      "target": "mgmt-sub01"
    },
    {
      "id": "e-nginx-rd01-rdir-sub01-attached",
      "role": "attached",
      "source": "nginx-rd01",
      "target": "rdir-sub01"
    },
    {
      "id": "e-myth-ts01-c2-sub01-attached",
      "role": "attached",
      "source": "myth-ts01",
      "target": "c2-sub01"
    },
    {
      "id": "e-nginx-rd01-myth-ts01-fronts",
      "role": "fronts",
      "source": "nginx-rd01",
      "target": "myth-ts01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/cdn/assets"
    },
    {
      "id": "e-jump-bx01-main-net01-manages",
      "role": "manages",
      "source": "jump-bx01",
      "target": "main-net01"
    }
  ],
  "prefix": "red"
}
