{
  "schema_version": "0.1.0",
  "mode": "ops",
  "name": "Minimal single redirector",
  "description": "Smallest valid graph. One redirector fronting one teamserver, reached for configuration through a jumpbox. No log collection.",
  "nodes": [
    {
      "id": "network-main",
      "kind": "network",
      "name": "RT-NET",
      "overlay": { "cidr": "10.20.0.0/16" }
    },
    {
      "id": "subnet-mgmt",
      "kind": "segment",
      "name": "RT-SEG-MGMT",
      "overlay": {
        "cidr": "10.20.0.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "management"
      }
    },
    {
      "id": "subnet-rdir",
      "kind": "segment",
      "name": "RT-SEG-RDIR",
      "overlay": {
        "cidr": "10.20.10.0/24",
        "egress": "allowed",
        "exposure": "internet",
        "tier": "redirector"
      }
    },
    {
      "id": "subnet-c2",
      "kind": "segment",
      "name": "RT-SEG-C2",
      "overlay": {
        "cidr": "10.20.20.0/24",
        "egress": "allowed",
        "exposure": "local",
        "tier": "c2"
      }
    },
    {
      "id": "rt-jump-01",
      "kind": "jumpbox",
      "name": "RT-JUMP-01",
      "overlay": {
        "services": ["ssh", "wireguard"],
        "certificate_authority": true
      }
    },
    {
      "id": "rt-rdir-01",
      "kind": "redirector",
      "name": "RT-RDIR-01",
      "overlay": {
        "server": "nginx",
        "hostname": "assets.example-lure.com",
        "tls": { "cert_source": "letsencrypt" }
      }
    },
    {
      "id": "rt-ts-01",
      "kind": "teamserver",
      "name": "RT-TS-01",
      "overlay": { "c2": "mythic" }
    }
  ],
  "edges": [
    { "id": "e-subnet-mgmt-network", "role": "attached", "source": "subnet-mgmt", "target": "network-main" },
    { "id": "e-subnet-rdir-network", "role": "attached", "source": "subnet-rdir", "target": "network-main" },
    { "id": "e-subnet-c2-network", "role": "attached", "source": "subnet-c2", "target": "network-main" },

    { "id": "e-jump-subnet", "role": "attached", "source": "rt-jump-01", "target": "subnet-mgmt" },
    { "id": "e-rdir-subnet", "role": "attached", "source": "rt-rdir-01", "target": "subnet-rdir" },
    { "id": "e-ts-subnet", "role": "attached", "source": "rt-ts-01", "target": "subnet-c2" },

    {
      "id": "e-front-01",
      "role": "fronts",
      "source": "rt-rdir-01",
      "target": "rt-ts-01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443
    },

    { "id": "e-manage-network", "role": "manages", "source": "rt-jump-01", "target": "network-main" }
  ]
}
