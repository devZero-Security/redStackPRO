      "target": "ts-03",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/updates"
    },
    {
      "id": "e-front-rdir-02-ts-01",
      "role": "fronts",
      "source": "rdir-02",
      "target": "ts-01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-front-rdir-02-ts-02",
      "role": "fronts",
      "source": "rdir-02",
      "target": "ts-02",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/cdn/assets"
    },
    {
      "id": "e-front-rdir-02-ts-03",
      "role": "fronts",
      "source": "rdir-02",
      "target": "ts-03",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/updates"
    },
    {
      "id": "e-log-rdir-01",
      "role": "logs_to",
      "source": "rdir-01",
      "target": "log-01"
    },
    {
      "id": "e-log-rdir-02",
      "role": "logs_to",
      "source": "rdir-02",
      "target": "log-01"
    },
    {
      "id": "e-log-ts-01",
