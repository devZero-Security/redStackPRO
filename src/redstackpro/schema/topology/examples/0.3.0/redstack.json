      "role": "attached",
      "source": "ts-01",
      "target": "subnet-c2"
    },
    {
      "id": "e-ts-02-subnet",
      "role": "attached",
      "source": "ts-02",
      "target": "subnet-c2"
    },
    {
      "id": "e-ts-03-subnet",
      "role": "attached",
      "source": "ts-03",
      "target": "subnet-c2"
    },
    {
      "id": "e-log-01-subnet",
      "role": "attached",
      "source": "log-01",
      "target": "subnet-log"
    },
    {
      "id": "e-ops-01-subnet",
      "role": "attached",
      "source": "ops-01",
      "target": "subnet-ops"
    },
    {
      "id": "e-ops-02-subnet",
      "role": "attached",
      "source": "ops-02",
      "target": "subnet-ops"
    },
    {
      "id": "e-front-rdir-01-ts-01",
      "role": "fronts",
      "source": "rdir-01",
      "target": "ts-01",
      "protocol": "https",
      "listen_port": 443,
      "upstream_port": 443,
      "uri_prefix": "/api/v1"
    },
    {
      "id": "e-front-rdir-01-ts-02",
      "role": "fronts",
      "source": "rdir-01",
      "target": "ts-02",
      "protocol": "https",
