{{ ansible_managed | comment }}
# The server. Client certificates for the declared operators are issued from the
# same CA in service-openvpn.yml. The protocol follows the overlay (udp by
# default, tcp for a restrictive network), matching the port Terraform opened.

port {{ redstackpro_openvpn_port }}
proto {{ redstackpro_openvpn_protocol }}
dev tun

ca {{ redstackpro_ca_dir }}/ca.crt
cert /etc/openvpn/server/pki/server.crt
key /etc/openvpn/server/pki/server.key
dh /etc/openvpn/server/pki/dh.pem

server {{ redstackpro_openvpn_subnet }} {{ redstackpro_openvpn_netmask }}
topology subnet
keepalive 10 120

cipher AES-256-GCM
auth SHA256
tls-version-min 1.2

user nobody
group nogroup
persist-key
persist-tun

status /var/log/openvpn-status.log
verb 3
