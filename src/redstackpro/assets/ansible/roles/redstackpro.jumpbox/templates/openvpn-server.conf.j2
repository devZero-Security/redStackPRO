{{ ansible_managed | comment }}
# The server. Client certificates for the declared operators are issued from the
# same CA in service-openvpn.yml. The protocol follows the overlay (udp by
# default, tcp for a restrictive network), matching the port Terraform opened.

port {{ redstackpro_openvpn_port }}
proto {{ redstackpro_openvpn_protocol }}
dev tun

ca {{ redstackpro_ca_dir }}/ca.crt
cert /etc/openvpn/server/pki/server.crt
key /etc/openvpn/server/pki/server.key
dh /etc/openvpn/server/pki/dh.pem

server {{ redstackpro_openvpn_subnet }} {{ redstackpro_openvpn_netmask }}
topology subnet
keepalive 10 120

# A cloud VPC MTU is often 1460 (GCP), below OpenVPN's 1500 tun default, so large
# packets over the tunnel blackhole while the handshake (small) succeeds: the
# tunnel comes up but the portal never answers. tun-mtu is pushed to clients, and
# mssfix clamps TCP MSS so HTTPS/RDP/SSH over the tunnel fit the path. WireGuard
# avoids this with its own 1420 default.
tun-mtu {{ redstackpro_openvpn_tun_mtu }}
mssfix {{ redstackpro_openvpn_mssfix }}

# Push the range networks so an operator's tunnel routes them (the WireGuard
# equivalent is the client's AllowedIPs). Without this the tunnel comes up but
# reaches nothing behind the jumpbox.
{% for route in redstackpro_openvpn_routes %}
push "route {{ route }}"
{% endfor %}

cipher AES-256-GCM
auth SHA256
tls-version-min 1.2

user nobody
group nogroup
persist-key
persist-tun

status /var/log/openvpn-status.log
verb 3
