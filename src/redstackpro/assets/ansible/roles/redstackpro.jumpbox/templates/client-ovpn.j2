{{ ansible_managed | comment }}
# One operator's OpenVPN client config, generated on the jumpbox with the CA,
# certificate and key inlined so it is a single file to hand over. Import it into
# an OpenVPN client. The remote is the jumpbox public address, which tf_inventory
# resolved into ansible_host.

client
dev tun
proto {{ redstackpro_openvpn_protocol }}
remote {{ ansible_host }} {{ redstackpro_openvpn_port }}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
tls-version-min 1.2
verb 3

<ca>
{{ redstackpro_ovpn_ca.content | b64decode | trim }}
</ca>
<cert>
{{ item.certificate }}
</cert>
<key>
{{ item.private_key }}
</key>
