{#
  A certreq request definition. The key is generated in the machine store and is
  not exportable, so it never leaves the host. The address goes in the
  subjectAltName because the control node connects by address, not by name, and
  a certificate that names only the host fails validation the same way the
  collector's would. See 0019 and 0022.
#}
[Version]
Signature = "$Windows NT$"

[NewRequest]
Subject = "CN={{ inventory_hostname }}"
MachineKeySet = TRUE
KeyLength = 2048
KeySpec = 1
KeyUsage = 0xA0
HashAlgorithm = SHA256
ProviderName = "Microsoft RSA SChannel Cryptographic Provider"
RequestType = PKCS10
Exportable = FALSE

[EnhancedKeyUsageExtension]
OID = 1.3.6.1.5.5.7.3.1

[Extensions]
2.5.29.17 = "{text}"
_continue_ = "dns={{ inventory_hostname }}&"
_continue_ = "ipaddress={{ ansible_host }}&"
