# Generated by redStackPRO. Ships Windows event logs to the range's ELK box.
winlogbeat.event_logs:
  - name: Application
  - name: System
  - name: Security
  - name: Microsoft-Windows-Sysmon/Operational
  - name: Windows PowerShell

output.logstash:
  hosts: ["{{ redstackpro_siem_addresses.elastic | default(redstackpro_siem_address) }}:5044"]

logging.level: info
