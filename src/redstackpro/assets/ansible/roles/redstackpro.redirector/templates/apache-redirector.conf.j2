# {{ ansible_managed }}
# Generated by redStackPRO from the topology. Two gates stand between the internet and
# a teamserver: the validation header and the URI prefix. A request failing
# either gets the decoy page and never reaches an upstream.
#
# One redirector fronts as many teamservers as it has fronts edges, each on its
# own prefix. That is redStack's shape.

{% macro routes() %}
{% for up in upstreams %}
    # {{ up.name }} on {{ up.uri_prefix }}
    # E=RSPBACKEND names the teamserver this request was handed to, so the access
    # log can say which one rather than leaving the collector to infer it from
    # the path. A request that fails either gate never sets it and logs "-",
    # which is what separates a callback from someone knocking.
    RewriteCond %{HTTP:{{ redstackpro_redirector_gating.header_name }}} ^{{ redstackpro_redirector_gating.header_value }}$
    RewriteRule ^{{ up.uri_prefix }}/(.*) https://{{ up.address }}:{{ up.port | default(443) }}/$1 [P,L,E=RSPBACKEND:{{ up.name }}]
    ProxyPassReverse {{ up.uri_prefix }}/ https://{{ up.address }}:{{ up.port | default(443) }}/
{% endfor %}
{% endmacro %}

{# Apache's own %{Header}i syntax collides with Jinja's braces, so the token is
   built here once rather than escaped at every use. #}
{% set gate_token = '%{' ~ redstackpro_redirector_gating.header_name ~ '}i' %}
# What the collector parses. `combined` is the web's lingua franca, but it records
# nothing about the two facts that matter on a redirector: whether the request
# carried the gating header, and which teamserver answered. Without those, a
# beacon callback and a scanner probing the same path are the same line. The
# model is RedELK's redirtraffic: enough per request to tell a customer from an
# investigator.
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\" rsp_gate=\"{{ gate_token }}\" rsp_backend=\"%{RSPBACKEND}e\" rsp_host=\"%{Host}i\"" redstackpro

# Port 80 answers the ACME http-01 challenge that issues the certificate and
# redirects everything else to 443, so a plain-http visitor lands on the real
# site and Let's Encrypt can reach the well-known path during issuance.
<VirtualHost *:80>
    ServerName {{ redstackpro_redirector_hostname | default(inventory_hostname, true) }}
    DocumentRoot /var/www/redstackpro-acme

    ErrorLog  /var/log/apache2/redstackpro-error.log
    CustomLog /var/log/apache2/redstackpro-access.log redstackpro

    Alias /.well-known/acme-challenge/ /var/www/redstackpro-acme/.well-known/acme-challenge/
    <Directory /var/www/redstackpro-acme>
        AllowOverride None
        Options -Indexes
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ redstackpro_redirector_hostname | default(inventory_hostname, true) }}
    DocumentRoot /var/www/redstackpro-decoy

    SSLEngine on
    SSLCertificateFile    /etc/redstackpro/tls/redirector.crt
    SSLCertificateKeyFile /etc/redstackpro/tls/redirector.key

    RewriteEngine On
    ErrorLog  /var/log/apache2/redstackpro-ssl-error.log
    CustomLog /var/log/apache2/redstackpro-ssl-access.log redstackpro

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-For "%{REMOTE_ADDR}e"

    Include /etc/redstackpro/redirect.rules

    # TLS terminates here, the request is gated, then re-encrypted to the
    # teamserver's own listener. Backend certs are self signed, so verification
    # is off on that hop only.
{{ routes() }}
    # A missing path returns the themed 404 rather than answering 200 to
    # everything, the way an ordinary site does.
    ErrorDocument 404 /404.html
    <Directory /var/www/redstackpro-decoy>
        AllowOverride All
        Options -Indexes
        Require all granted
    </Directory>

    SSLProxyEngine On
    SSLProxyVerify none
    SSLProxyCheckPeerCN off
    SSLProxyCheckPeerName off
</VirtualHost>
