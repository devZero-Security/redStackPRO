# {{ ansible_managed }}
# Generated by redStackPRO from the topology. Same two gates as the Apache variant:
# validation header, then URI prefix. Everything else gets the decoy.

map $http_{{ redstackpro_redirector_gating.header_name | lower | replace('-', '_') }} $redstackpro_gated {
    default                       0;
    "{{ redstackpro_redirector_gating.header_value }}"  1;
}

# What the collector parses, matching the Apache variant field for field so one
# grok serves both. `combined` records nothing about the two facts that matter on
# a redirector -- whether the request carried the gating header, and which
# teamserver answered -- and without them a beacon callback and a scanner
# probing the same path are the same line. The model is RedELK's redirtraffic.
log_format redstackpro '$remote_addr - $remote_user [$time_local] '
                       '"$request" $status $body_bytes_sent '
                       '"$http_referer" "$http_user_agent" '
                       'rsp_gate="$redstackpro_gate_seen" '
                       'rsp_backend="$redstackpro_backend" '
                       'rsp_host="$host"';

# $redstackpro_gated answers "may this through"; the log also wants "what was
# presented", so an operator can see a wrong token as distinct from none at all.
map $http_{{ redstackpro_redirector_gating.header_name | lower | replace('-', '_') }} $redstackpro_gate_seen {
    default  $http_{{ redstackpro_redirector_gating.header_name | lower | replace('-', '_') }};
    ""       "-";
}

# Port 80 answers the ACME http-01 challenge that issues the certificate and
# redirects everything else to 443, so a plain-http visitor lands on the real
# site and Let's Encrypt can reach the well-known path during issuance.
server {
    listen 80;
    server_name {{ redstackpro_redirector_hostname | default(inventory_hostname, true) }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/redstackpro-acme;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    # Default for every request that is not proxied to a teamserver.
    set $redstackpro_backend "-";
    server_name {{ redstackpro_redirector_hostname | default(inventory_hostname, true) }};

    ssl_certificate     /etc/redstackpro/tls/redirector.crt;
    ssl_certificate_key /etc/redstackpro/tls/redirector.key;

    access_log /var/log/nginx/redstackpro-access.log redstackpro;
    error_log  /var/log/nginx/redstackpro-error.log;

    root /var/www/redstackpro-decoy;
    index index.html;

    # A path that is not a real decoy page returns a themed 404, the way an
    # ordinary site does, so the cover does not answer 200 to everything.
    error_page 404 /404.html;

{% for up in upstreams %}
    # {{ up.name }}
    location {{ up.uri_prefix }}/ {
        set $redstackpro_backend "{{ up.name }}";
        if ($redstackpro_gated = 0) {
            rewrite ^ /index.html last;
        }
        proxy_pass https://{{ up.address }}:{{ up.port | default(443) }}/;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

{% endfor %}
    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
